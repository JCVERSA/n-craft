# Generated automatically by `ncraft setup` on first installation.
# Keep it private; `ncraft env get PANEL_TOKEN --reveal` displays it locally when needed.
PANEL_TOKEN=

# Network tunnel provider. Localtonet is the default; set to `playit` to use Playit instead.
TUNNEL_PROVIDER=localtonet

# Localtonet Linux client and device AuthToken. Keep both Localtonet secrets server-side.
# Create a UDP tunnel manually in Localtonet's dashboard: local target 127.0.0.1:19132.
LOCALTONET_BIN=localtonet
LOCALTONET_AUTH_TOKEN=
# Separate Localtonet API key used by the panel to discover the public host:port.
LOCALTONET_API_KEY=
LOCALTONET_API_POLL_INTERVAL_MS=30000
LOCALTONET_API_TIMEOUT_MS=8000

# Optional Playit fallback. No Playit key is required in this file:
# Playit stores its secret in its private runtime file after dashboard claim.
PLAYIT_BIN=playitd
PLAYIT_CLI_BIN=playit
# Optional: override the default secret file path (never put the secret itself here).
PLAYIT_SECRET_PATH=

# HTTP listener inside the provided container.
PORT=3000

# Optional paths (relative to the project root by default).
DATA_DIR=./data
BEDROCK_SERVER_DIR=./bedrock/server

# Exact public browser origin; set when a reverse proxy changes Host or when its
# external origin cannot be inferred. Example: PANEL_ORIGIN=https://panel.example.com
PANEL_ORIGIN=

# Number of trusted proxy hops or comma-separated proxy IP/CIDRs. Default 0.
# Set to 1 only when the app is reachable exclusively through one trusted proxy.
PANEL_TRUST_PROXY=0

# Optional operational limits.
BDS_START_TIMEOUT_MS=60000
BDS_STOP_TIMEOUT_MS=10000
# Daily graceful Bedrock restart in the local time zone; sends one in-game warning each minute.
BDS_RESTART_ENABLED=true
BDS_RESTART_TIME=04:00
BDS_RESTART_TIMEZONE=Africa/Douala
BDS_RESTART_WARNING_MINUTES=5
PLAYIT_START_TIMEOUT_MS=20000
PLAYIT_ADDRESS_TIMEOUT_MS=25000
BDS_MAX_ZIP_BYTES=1073741824
